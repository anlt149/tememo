---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div>&copy; {today.getFullYear()} An Le</div>
		<div class="flex-1"></div>
		<a href="/rss.xml" class="rss-link">RSS</a>
	</div>
</footer>
<style>
	.site-footer {
		background-color: var(--stone-100);
		height: 4rem;
		display: flex;
		align-items: center;
		font-family: var(--font-serif);
		color: var(--stone-500);
		font-size: 0.875rem;
		margin-top: auto;
	}
	.footer-container {
		width: 100%;
		max-width: 42rem;
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		flex-direction: row;
	}
	.flex-1 {
		flex: 1 1 0%;
	}
	.rss-link {
		color: var(--orange-500);
		text-decoration: none;
	}
	.rss-link:hover {
		text-decoration: underline;
	}
</style>
