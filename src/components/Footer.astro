---
const today = new Date();
---

<footer>
	<div class="footer-content">
		&copy; {today.getFullYear()} Tememo.
	</div>
</footer>
<style>
	footer {
		padding: 2rem 1rem;
		color: var(--text-muted);
		text-align: left;
		font-size: 0.85rem;
	}
	.footer-content {
		max-width: 680px;
		margin: 0 auto;
		border-top: 1px solid var(--border-color);
		padding-top: 2rem;
	}
</style>
