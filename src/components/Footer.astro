---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div>&copy; {today.getFullYear()} An Le</div>
	</div>
</footer>
<style>
	.site-footer {
		background-color: transparent;
		border-top: 1px solid var(--border-color);
		height: 4rem;
		display: flex;
		align-items: center;
		font-family: var(--font-serif);
		color: var(--text-muted);
		font-size: 0.875rem;
		margin-top: auto;
	}
	.footer-container {
		width: 100%;
		max-width: 42rem;
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		flex-direction: row;
	}
</style>
