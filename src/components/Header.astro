---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/`}>{SITE_TITLE}</a></h2>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 3rem 1em 1rem 1em;
		background: transparent;
	}
	nav {
		max-width: 680px;
		margin: 0 auto;
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}
	h2 a {
		text-decoration: none;
		color: var(--text-color);
	}
	h2 a:hover {
		opacity: 0.7;
	}
</style>
