---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<div class="header-container">
		<nav>
			<a aria-current="page" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/`}>
				{SITE_TITLE}<span class="cursor">▮</span>
			</a>
		</nav>
	</div>
</header>
<style>
	.site-header {
		background-color: var(--stone-100);
		height: 4rem;
		display: flex;
		align-items: center;
		font-family: var(--font-serif);
	}
	.header-container {
		width: 100%;
		max-width: 42rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	nav a {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--heading-color);
		text-decoration: none;
	}
	.cursor {
		color: var(--stone-500);
		animation: blink 1.25s linear infinite;
	}
	@keyframes blink {
		50% { opacity: 0; }
	}
</style>
