---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { id?: string };

const { title, description, pubDate, updatedDate, tags, id } = Astro.props;
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			article {
				padding: 0;
			}
			.page-header {
				margin-bottom: 2rem;
			}
			.breadcrumb {
				font-family: var(--font-sans);
				font-size: 0.9rem;
				margin-bottom: 1rem;
				color: var(--text-muted);
			}
			.breadcrumb ol {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
			}
			.breadcrumb a {
				color: var(--accent);
				text-decoration: none;
			}
			.breadcrumb a:hover {
				text-decoration: underline;
			}
			.breadcrumb .separator {
				color: var(--border-color);
			}
			.page-title {
				font-size: 2.25rem;
				font-weight: 800;
				margin-top: 1rem;
				margin-bottom: 0.5rem;
				font-family: var(--font-sans);
				color: var(--heading-color);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.tag {
				font-family: var(--font-sans);
				font-size: 0.85rem;
				color: var(--accent);
				background-color: var(--bg-highlight);
				padding: 0.2rem 0.6rem;
				border-radius: 9999px;
				text-decoration: none;
				transition: background-color 0.2s;
			}
			.tag:hover {
				background-color: var(--border-color);
			}
			.date {
				font-family: var(--font-sans);
				font-size: 1.2rem;
				color: var(--text-muted);
				margin-bottom: 1rem;
			}
			.last-updated-on {
				font-style: italic;
				margin-top: 0.25rem;
			}
			.export-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				font-family: var(--font-sans);
				font-size: 0.85rem;
				color: var(--accent);
				background: none;
				border: 1px solid var(--accent);
				padding: 0.2rem 0.6rem;
				border-radius: 0.3rem;
				text-decoration: none;
				margin-left: auto;
				transition: all 0.2s;
			}
			.export-btn:hover {
				background-color: var(--accent);
				color: var(--bg-color);
			}
			.post-nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-color);
				font-family: var(--font-mono, monospace);
				font-size: 0.9rem;
			}
			.post-nav .nav-link {
				color: var(--accent);
				text-decoration: none;
			}
			.post-nav .nav-link:hover {
				text-decoration: underline;
			}
			@media (max-width: 600px) {
				.page-title {
					font-size: 1.75rem;
				}
				.date {
					font-size: 1rem;
				}
				.post-nav {
					flex-direction: column;
					gap: 1.5rem;
					align-items: flex-start;
					margin-top: 3rem;
				}
				.export-btn {
					margin-left: 0;
					margin-top: 0.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="page-header">
					<nav aria-label="Breadcrumb" class="breadcrumb">
						<ol>
							<li><a href={`${baseUrl}/`}>Home</a></li>
							<li class="separator">/</li>
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
					<h1 class="page-title">{title}</h1>
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => (
								<a href={`${baseUrl}/tags/${tag}/`} class="tag">#{tag}</a>
							))}
						</div>
					)}
					<div class="date" style="display: flex; align-items: center; flex-wrap: wrap; gap: 1rem;">
						<div>
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										(Updated: <FormattedDate date={updatedDate} />)
									</div>
								)
							}
						</div>
						{id && (
							<a href={`${baseUrl}/${id}.md`} class="export-btn" download={`${id}.md`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
									<polyline points="7 10 12 15 17 10"></polyline>
									<line x1="12" y1="15" x2="12" y2="3"></line>
								</svg>
								Export Markdown
							</a>
						)}
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
				<nav class="post-nav">
					<a href={`${baseUrl}/`} class="nav-link">← All posts</a>
					{tags && tags.length > 0 && (
						<a href={`${baseUrl}/tags/${tags[0]}/`} class="nav-link">More in {tags[0].charAt(0).toUpperCase() + tags[0].slice(1)} →</a>
					)}
				</nav>
			</article>
		</main>
		<Footer />
		<script>
			const blocks = document.querySelectorAll('pre');
			blocks.forEach((block) => {
				if (block.parentNode?.classList.contains('code-block-wrapper')) return;

				const wrapper = document.createElement('div');
				wrapper.className = 'code-block-wrapper';
				
				block.parentNode?.insertBefore(wrapper, block);
				wrapper.appendChild(block);

				const copyButton = document.createElement('button');
				copyButton.className = 'copy-code';
				copyButton.innerHTML = 'Copy';

				copyButton.addEventListener('click', async () => {
					const code = block.querySelector('code');
					const text = code ? code.innerText : block.innerText;
					await navigator.clipboard.writeText(text);
					copyButton.innerHTML = 'Copied!';
					setTimeout(() => {
						copyButton.innerHTML = 'Copy';
					}, 2000);
				});

				wrapper.appendChild(copyButton);
			});
		</script>
	</body>
</html>
