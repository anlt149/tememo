---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.blog-header {
				margin-bottom: 4rem;
				text-align: center;
			}
			.blog-header h1 {
				font-size: 3.5rem;
				font-weight: 800;
				color: #f8fafc;
				margin-bottom: 1rem;
			}
			.blog-header p {
				color: #94a3b8;
				font-size: 1.25rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				background: rgba(30, 41, 59, 0.5);
				border: 1px solid rgba(255, 255, 255, 0.05);
				border-radius: 16px;
				overflow: hidden;
				transition: all 0.3s ease;
			}
			ul li:hover {
				transform: translateY(-8px);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
				border-color: rgba(56, 189, 248, 0.3);
			}
			ul li * {
				text-decoration: none;
			}
			ul li:first-child {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				background: transparent;
				border: none;
				align-items: center;
			}
			ul li:first-child:hover {
				transform: none;
				box-shadow: none;
			}
			ul li:first-child .post-content {
				padding: 2rem 0;
			}
			ul li:first-child img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 20px;
				box-shadow: 0 20px 40px rgba(0,0,0,0.4);
				transition: transform 0.5s ease;
			}
			ul li:first-child:hover img {
				transform: scale(1.02);
			}
			ul li:first-child .title {
				font-size: 2.5rem;
				margin-bottom: 1rem;
			}
			ul li img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.post-content {
				padding: 1.5rem;
			}
			.title {
				margin: 0;
				color: #f8fafc;
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.date {
				margin: 0.5rem 0 0 0;
				color: #64748b;
				font-size: 0.9rem;
			}
			ul li a {
				display: block;
				height: 100%;
			}
			ul li a:hover .title {
				color: #38bdf8;
			}
			@media (max-width: 768px) {
				ul li:first-child {
					grid-template-columns: 1fr;
					gap: 1rem;
					background: rgba(30, 41, 59, 0.5);
					border: 1px solid rgba(255, 255, 255, 0.05);
				}
				ul li:first-child .post-content {
					padding: 1.5rem;
				}
				ul li:first-child img {
					height: 250px;
					border-radius: 16px 16px 0 0;
					border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				}
				ul li:first-child:hover {
					transform: translateY(-8px);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<h1>Journal & Thoughts</h1>
				<p>Insights, updates, and deep dives into technology.</p>
			</div>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="post-content">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
