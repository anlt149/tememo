---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.page-header {
				margin-bottom: 2rem;
			}
			.page-title {
				font-size: 2.25rem;
				font-weight: 800;
				margin-top: 2.5rem;
				font-family: var(--font-sans);
				color: var(--heading-color);
			}
			.github-link {
				font-size: 0.875rem;
				color: var(--gray-500);
				text-decoration: none;
				margin-top: 0.25rem;
				display: block;
				font-family: var(--font-sans);
			}
			.section-title {
				font-size: 1.5rem;
				font-weight: 600;
				font-family: var(--font-serif);
				margin-top: 2rem;
				margin-bottom: 1rem;
			}
			.section-title a {
				color: var(--heading-color);
				text-decoration: none;
			}
			.post-list {
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				display: flex;
				flex-direction: column;
				margin-bottom: 2rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border-color);
			}
			.post-item:last-child {
				border-bottom: none;
				margin-bottom: 0;
				padding-bottom: 0;
			}
			.post-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--heading-color);
				text-decoration: none;
				font-family: var(--font-serif);
				margin-bottom: 0.5rem;
			}
			.post-title:hover {
				text-decoration: underline;
			}
			.post-description {
				font-size: 1rem;
				color: var(--text-color);
				margin-bottom: 0.75rem;
				line-height: 1.5;
				margin-top: 0;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				font-family: var(--font-sans);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}
			.post-tag {
				font-size: 0.65rem;
				background-color: var(--bg-highlight);
				color: var(--text-color);
				padding: 0.1rem 0.4rem;
				border-radius: 9999px;
				text-transform: lowercase;
				text-decoration: none;
				transition: background-color 0.2s;
			}
			.post-tag:hover {
				background-color: var(--border-color);
			}
			.post-date {
				color: var(--text-muted);
				font-size: 0.9rem;
			}
			@media (max-width: 600px) {
				.page-title {
					font-size: 1.75rem;
					margin-top: 1.5rem;
				}
				.section-title {
					font-size: 1.25rem;
				}
				.post-title {
					font-size: 1.1rem;
				}
				.post-item {
					margin-bottom: 1.5rem;
					padding-bottom: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<div class="page-title">Tech Memo</div>
			</header>

			<div class="section-title">
				<a href="#recently-added">Recently Added</a>
			</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-item">
							<a class="post-title" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/${post.id}/`}>
								{post.data.title}
							</a>
							{post.data.description && (
								<p class="post-description">{post.data.description}</p>
							)}
							<div class="post-meta">
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.map((tag) => (
											<a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/tags/${tag}/`} class="post-tag">{tag}</a>
										))}
									</div>
								)}
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
