---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeaderLink from '../components/HeaderLink.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-height: calc(100vh - 200px);
			}
			.hero {
				text-align: center;
				margin-bottom: 4rem;
				animation: fadeIn 1s ease-out;
			}
			.hero h1 {
				font-size: 4rem;
				font-weight: 800;
				background: linear-gradient(135deg, #38bdf8, #818cf8);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				margin-bottom: 1rem;
				letter-spacing: -0.05em;
			}
			.hero p {
				font-size: 1.5rem;
				color: #94a3b8;
				max-width: 600px;
				margin: 0 auto;
				line-height: 1.6;
			}
			.cta-buttons {
				margin-top: 2rem;
				display: flex;
				gap: 1rem;
				justify-content: center;
			}
			.cta-btn {
				padding: 0.75rem 2rem;
				border-radius: 9999px;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.3s ease;
			}
			.cta-primary {
				background-color: var(--accent);
				color: #0f172a;
				box-shadow: 0 4px 14px 0 rgba(56, 189, 248, 0.39);
			}
			.cta-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(56, 189, 248, 0.5);
			}
			.cta-secondary {
				background-color: rgba(255, 255, 255, 0.1);
				color: var(--text-color);
				backdrop-filter: blur(10px);
			}
			.cta-secondary:hover {
				background-color: rgba(255, 255, 255, 0.2);
				transform: translateY(-2px);
				color: #fff;
			}
			.features {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}
			.feature-card {
				background: var(--card-bg);
				padding: 2rem;
				border-radius: 16px;
				border: 1px solid rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(10px);
				transition: transform 0.3s ease, border-color 0.3s ease;
			}
			.feature-card:hover {
				transform: translateY(-5px);
				border-color: var(--accent);
			}
			.feature-card h3 {
				color: var(--text-color);
				font-size: 1.25rem;
				margin-bottom: 0.5rem;
			}
			.feature-card p {
				color: #94a3b8;
				line-height: 1.5;
				margin-bottom: 0;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Welcome to Tememo</h1>
				<p>A beautiful, modern digital space to share thoughts, stories, and ideas.</p>
				<div class="cta-buttons">
					<HeaderLink href="/blog" class="cta-btn cta-primary">Read the Blog</HeaderLink>
					<HeaderLink href="/about" class="cta-btn cta-secondary">About Me</HeaderLink>
				</div>
			</section>

			<section class="features">
				<div class="feature-card">
					<h3>📝 Minimalist Writing</h3>
					<p>Focus on your content with a distraction-free reading experience.</p>
				</div>
				<div class="feature-card">
					<h3>✨ Premium Design</h3>
					<p>Enjoy a sleek, dark-themed interface with smooth micro-animations.</p>
				</div>
				<div class="feature-card">
					<h3>🚀 Lightning Fast</h3>
					<p>Built with modern web standards for unparalleled performance.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
